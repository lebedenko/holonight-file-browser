@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.11 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/HolonightFileBrowserCoreTargets.cmake")
set(HolonightFileBrowser_Core_FOUND TRUE)
set(_browser_components ${HolonightFileBrowser_FIND_COMPONENTS})
if("Markdown" IN_LIST _browser_components)
  list(APPEND _browser_components PreviewQuick)
endif()
if("PreviewQuick" IN_LIST _browser_components)
  list(APPEND _browser_components Preview Quick)
endif()
if("Quick" IN_LIST _browser_components)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HolonightFileBrowserQuickTargets.cmake")
    find_dependency(Qt6 6.11 COMPONENTS Gui Quick Qml QuickControls2)
    find_dependency(HolonightQt CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/HolonightFileBrowserQuickTargets.cmake")
    set(HolonightFileBrowser_Quick_FOUND TRUE)
  else()
    set(HolonightFileBrowser_Quick_FOUND FALSE)
  endif()
endif()
foreach(_component Search Storage Preview PreviewQuick Markdown)
  if(_component IN_LIST _browser_components)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HolonightFileBrowser${_component}Targets.cmake")
      if(_component STREQUAL "Search")
        find_dependency(HolonightSearch CONFIG)
      elseif(_component STREQUAL "Storage")
        find_dependency(HoloNightSystemServices CONFIG COMPONENTS Storage)
      elseif(_component STREQUAL "Preview")
        find_dependency(Qt6 6.11 COMPONENTS Gui Svg)
        find_dependency(HolonightImages CONFIG)
        find_dependency(HolonightThumbnails CONFIG)
      elseif(_component STREQUAL "Markdown")
        find_dependency(QMarkdown 1.1 CONFIG)
      endif()
      include("${CMAKE_CURRENT_LIST_DIR}/HolonightFileBrowser${_component}Targets.cmake")
      set(HolonightFileBrowser_${_component}_FOUND TRUE)
    else()
      set(HolonightFileBrowser_${_component}_FOUND FALSE)
    endif()
  endif()
endforeach()
check_required_components(HolonightFileBrowser)
